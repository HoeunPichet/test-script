; ===============================
; SuperTradingEA v2.10
; AGGRESSIVE GRID PRESET
; ===============================

; === GENERAL CONTROL ===
MasterEnableTrading=true

; === LOT SETTINGS ===
StartingLots=0.01
LayerMultiplier=1.5
MaximumLotSizeCap=50.0

; === GRID SETTINGS ===
UseOpenCandle=true
PipStep=150.0
MaxTrades=200

; === STARTUP MODE ===
AutoStartTrendBased=false
StartInRangeToo=true

; === ENTRY THROTTLE ===
OneTradePerBar=false
MinSecondsBetweenEntries=0

; === ADAPTIVE PIP STEP ===
PipStepMode=0
ATRPeriod=14
ATRSimpleMultiplier=1.5
ATRPercentileLookback=50
BBPeriod=20
BBDeviation=2.0
BBWidthMasterMultiplier=1.5
RangeFastBars=10
RangeSlowBars=50
PriceRangeMasterMultiplier=2.25
MinAdaptiveStepPips=10.0
MaxAdaptiveStepPips=5000.0
HybridVolatilityThreshold=1.1
StepSmoothingAlpha=0.2
StepMaxIncreasePctPerUpdate=30.0
StepMaxDecreasePctPerUpdate=20.0
SpreadMinStepMultiplier=3.0

; === LAYER-BASED MAX STEP CAP ===
UseLayerBasedMaxStepCap=false
LayerCapBlockSize=5
LayerCapBlockPips=0.0
LayerCapHardMaxPips=0.0

; === STOCHASTIC ===
EnableStochFilter=false
StochTimeframe=1
StochKPeriod=14
StochDPeriod=3
StochSlowing=3
StochOverbought=80.0
StochOversold=20.0
StochFirstEntryOnly=true

; === TAKE PROFIT MODE ===
EnableBasketTakeProfit=true
BasketTakeProfitMode=0
BasketTP_FixedPips=30.0
BasketTP_ATRSmoothPeriod=14
BasketTP_ATRMultiplierK=0.10

; === TRADING DIRECTION ===
EnableBuy=true
BuyMagicNumber=1001
EnableSell=true
SellMagicNumber=1002

; === EQUITY PROTECTION ===
EnableEquityProtection=false
StopLossDrawdownPercent=50.0

; === SAFETY FILTERS ===
CheckMarginBeforeTrade=true
MinFreeMarginPercentRequired=20.0
EnableSpreadFilter=true
MaxSpreadPips=50.0
PauseOnExtremeVolatility=false
PauseIfATRMulAboveNormal=1.3
ATRNormalLookbackBars=200

; === DAILY PROFIT TARGET ===
UseDailyProfitLimit=false
DailyProfitMode=0
DailyGrossProfitLimit=3.0
DailyProfitMoneyTarget=100.0
CloseAllWhenLimitReached=true

; === SESSION FILTER ===
EnableSessionFilter=false
CloseAllOutsideSession=false
LocalTimezoneUTCOffsetHours=7
TradeAsiaSession=true
AsiaSessionLocal=06:30-04:00
TradeLondonSession=false
LondonSessionLocal=14:00-18:00
TradeNewYorkSession=false
NewYorkSessionLocal=19:00-23:00

; === SMART REGIME ===
EnableSmartRegime=false
Regime_ADXPeriod=14
Regime_ADXTrend=25.0
Regime_MAperiod=200
Regime_MA_ATR_Dist=1.0
Regime_ImpulseATR=2.2
RangeStepMul=1.0
TrendStepMul=1.8
SpikeStepMul=3.0
SpikeFreezeSeconds=0

; === RISK ENGINE ===
MaxTotalLotsPerSide=50.0
MaxFloatingLossMoneyPerSide=999999
CloseSideOnHardLoss=false

; === LAYER RATE LIMIT ===
EnableLayersPerHourLimit=false
MaxNewLayersPerHour=100

; === DASHBOARD ===
EnableDashboard=true
DashCorner=0
DashX=15
DashY=15
DashW=520
